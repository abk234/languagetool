# Copy to scripts/languagetool-app.env (gitignored) and adjust.

# HTTP API port on the host
LANGUAGETOOL_PORT=8010

# Community image (official monorepo has no Docker; see README Docker section)
LANGUAGETOOL_IMAGE=erikvl87/languagetool:latest

# JVM heap for the container
Java_Xms=256m
Java_Xmx=512m

# Compose file relative to docker/compose/
COMPOSE_FILE=docker-compose.yml

# Backup
BACKUP_DIR=../languagetool-backups
BACKUP_INTERVAL_DAYS=30
BACKUP_KEEP=3
UPDATE_SYNC_ON_UPDATE=true

# SquadOS: LanguageTool has no LLM / search / app telemetry — leave unset.
# SQUADOS_ROOT=$HOME/workspace_for_ai/1/SquadOS
